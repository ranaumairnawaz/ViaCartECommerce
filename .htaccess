DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) If a .php URL is requested directly (GET only, so POST form submissions
#    are never affected), send a permanent redirect to the clean URL.
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} ^GET\ /(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Internally serve the matching .php file for a clean, extension-less URL.
#    This does not change the browser's address bar and works for POST too.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
</IfModule>
